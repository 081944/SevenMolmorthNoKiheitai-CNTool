@echo off
setlocal
cd /d "%~dp0"

set "IMAGE=%~dp0original\CDIMAGE.BIN"
set "UNPACKED=%~dp0unpacked\CDIMAGE_FULL"
set "TRANSLATION=%~dp0work\translation"
set "IMAGE_MANIFEST=%~dp0work\imageedit\manifest.csv"
set "OUT=%~dp0work\build\CDIMAGE.BIN"
set "ORIGINAL_TREE=%~dp0temp\original_build_tree"
set "PACK_DIR=%~dp0mkps2iso-1.1.1-win64\Seven"
set "MKPS2ISO=%~dp0mkps2iso-1.1.1-win64\mkps2iso.exe"

echo Seven Warriors translation and image build
echo.

if not exist "%IMAGE%" (
    echo ERROR: missing Japanese source image:
    echo        %IMAGE%
    echo Put the pristine Japanese 7W CDIMAGE.BIN there first.
    pause
    exit /b 1
)
if not exist "%UNPACKED%\manifest.tsv" (
    echo ERROR: missing unpacked tree or manifest:
    echo        %UNPACKED%\manifest.tsv
    pause
    exit /b 1
)
if not exist "%IMAGE_MANIFEST%" (
    echo ERROR: missing image manifest:
    echo        %IMAGE_MANIFEST%
    echo Run image_7w.py scan/export first, then copy the manifest and edited PNGs under work\imageedit.
    pause
    exit /b 1
)
echo Unpacking the pristine Japanese source...
python tools\unpack_cdimage.py unpack --reuse-existing "%IMAGE%" "%ORIGINAL_TREE%"
if errorlevel 1 (
    echo ERROR: could not unpack the Japanese source image.
    pause
    exit /b 1
)
for /f %%N in ('findstr /R /N "^" "%ORIGINAL_TREE%\manifest.tsv" ^| find /C ":"') do set /a ENTRY_COUNT=%%N-1
if not "%ENTRY_COUNT%"=="2718" (
    echo ERROR: this is not the 7W CDIMAGE.BIN.
    echo        Expected 2718 entries, found %ENTRY_COUNT%.
    echo        The required image must contain seven_data_link\rpgdata\output\*.spl
    pause
    exit /b 1
)
if not exist "%ORIGINAL_TREE%\seven_data_link\rpgdata\output\00000_index.spl" (
    echo ERROR: 7W SPL directory is missing from the source image.
    pause
    exit /b 1
)
echo Source image validated: 2718 entries, 7W SPL tree found.

if not exist "%PACK_DIR%" (
    echo ERROR: missing mkps2iso Seven directory:
    echo        %PACK_DIR%
    pause
    exit /b 1
)
if not exist "%MKPS2ISO%" (
    echo ERROR: missing mkps2iso executable:
    echo        %MKPS2ISO%
    pause
    exit /b 1
)

python tools\build_all.py ^
  --image "%IMAGE%" ^
  --unpacked "%UNPACKED%" ^
  --original-tree "%ORIGINAL_TREE%" ^
  --translation "%TRANSLATION%" ^
  --font-target both ^
  --write-images ^
  --out "%OUT%" ^
  --pack-dir "%PACK_DIR%" ^
  --mkps2iso "%MKPS2ISO%"

if errorlevel 1 (
    echo.
    echo BUILD FAILED. No ISO was generated by this run.
    pause
    exit /b 1
)

echo.
echo BUILD COMPLETE. Translated text and edited images were included.
echo Check Seven.iso next to the mkps2iso XML file.
pause
endlocal
